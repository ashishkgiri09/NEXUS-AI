{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Nexus Backend (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nexus"
      }
    },
    {
      "label": "Start Nexus Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nexus"
      }
    },
    {
      "label": "Run End-to-End Tests",
      "type": "shell",
      "command": "python -m pytest tests/test_workflow.py -v -s",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
